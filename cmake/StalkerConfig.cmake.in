@PACKAGE_INIT@

# Import the targets from the installed export set
include("${CMAKE_CURRENT_LIST_DIR}/StalkerTargets.cmake")

# Back-compat alias (optional)
if(NOT TARGET Stalker::Stalker)
    add_library(Stalker::Stalker INTERFACE IMPORTED)
    set_target_properties(Stalker::Stalker PROPERTIES INTERFACE_LINK_LIBRARIES Stalker)
endif()
